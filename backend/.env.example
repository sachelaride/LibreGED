# Local development environment
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eduged_libre
ENVIRONMENT=development
MAX_UPLOAD_SIZE_BYTES=10485760

# Must be a strong secret in real deployments. Do not commit real values.
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=6000

# Must be a valid Fernet 32-byte URL-safe base64 key.
ENCRYPTION_KEY=CHANGE_ME
